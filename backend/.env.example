# Local template only. Select ENVIRONMENT in the process before starting Python:
# ENVIRONMENT=local uvicorn app.main:app --reload
# Production/staging ignore .env and require explicitly injected configuration.
GOOGLE_CLIENT_ID=your-local-client-id
GOOGLE_CLIENT_SECRET=your-local-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/connect/google_fit/callback
CONFIG_PATH=./config.yaml
# SECRET_KEY and JWT_SECRET_KEY: omit locally for random ephemeral keys.
# Restart invalidates sessions/OAuth states unless private stable keys are supplied.
# Production requires both keys; never use placeholders or commit private values.
# CORS_ORIGINS is a JSON array. Production defaults to no cross-origin access.
# CORS_ORIGINS=["https://your-web-origin.example"]
# Demo seed is disabled by default and never available in production/staging.
ALLOW_DEV_SEED=false
# To opt in locally, set ALLOW_DEV_SEED=true and supply a private DEMO_PASSWORD
# meeting the existing registration password policy. Do not commit it.
