# Copie para .env e preencha os valores
# NUNCA commite o .env

# Google OAuth — crie em https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-project.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-secret
GCP_PROJECT_ID=your-gcp-project-id

# URL de redirecionamento OAuth (deve estar registrada no Google Console)
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/connect/google_fit/callback

# Chave para assinar o state anti-CSRF
SECRET_KEY=change-me-to-a-random-secret

# Ambiente: local | gcp
ENVIRONMENT=local

# Caminho para o config.yaml
CONFIG_PATH=./config.yaml
