# Public API endpoint, never a secret. Expo inlines EXPO_PUBLIC_* into the app.
# Development only: use 10.0.2.2 instead of localhost for an Android emulator.
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
# Production builds require an explicit non-local HTTPS endpoint ending /api/v1.
# Never put credentials, signing keys, passwords or tokens in EXPO_PUBLIC_*.
